{
  "name": "ts7-lit-analyzer-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "26.6.5",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
