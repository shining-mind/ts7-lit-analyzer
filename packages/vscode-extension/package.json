{
  "name": "ts7-lit-extension",
  "displayName": "TypeScript 7 Lit Extension",
  "description": "Type-aware Lit tooling for TypeScript 7 projects",
  "publisher": "ts7-lit-analyzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/shining-mind/ts7-lit-analyzer.git",
    "directory": "packages/vscode-extension"
  },
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "TypeScript 7 Lit Analyzer",
      "properties": {
        "ts7LitAnalyzer.analysis.trigger": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "default": "onType",
          "description": "When to run component analysis for changed documents."
        },
        "ts7LitAnalyzer.analysis.debounceMs": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Trailing debounce for onType analysis in milliseconds."
        },
        "ts7LitAnalyzer.analysis.maxWaitMs": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum time continuous typing can postpone onType analysis."
        },
        "ts7LitAnalyzer.analysis.maxResidentProjects": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Maximum live or creating registry sessions; older projects are evicted by LRU."
        },
        "ts7LitAnalyzer.logging.level": {
          "type": "string",
          "enum": [
            "normal",
            "verbose",
            "debug"
          ],
          "default": "normal",
          "description": "Diagnostic Output verbosity. Timing and memory instrumentation is enabled only in verbose or debug mode."
        }
      }
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json --noEmit false --outDir .test-dist",
    "typecheck": "tsc -p tsconfig.json",
    "test:vscode": "pnpm run build:test && vscode-test",
    "package:vsix": "vsce package --no-dependencies --out dist/ts7-lit-extension-0.0.0.vsix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "mocha": "12.0.3",
    "rolldown": "1.2.15"
  },
  "dependencies": {
    "@ts7-lit-analyzer/analyzer-core": "workspace:*"
  }
}
